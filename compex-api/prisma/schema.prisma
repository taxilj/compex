generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum RFQStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SOURCING
  CANCELLED
}

// Internal sourcing progress is deliberately separate from RFQStatus.  That
// preserves the meaning of existing customer-visible RFQ records while giving
// staff an explicit, private workflow after an RFQ has been submitted.
enum SourcingStatus {
  NEW
  REVIEWING
  SOURCING
  SUPPLIER_QUOTES_PENDING
  SUPPLIER_QUOTES_RECEIVED
  COMPARE
  CUSTOMER_QUOTE_READY
  QUOTE_SENT
  ACCEPTED
  REJECTED
  ORDER_PROCUREMENT
}

enum RFQPriority {
  LOW
  MEDIUM
  HIGH
}

enum RFQItemStatus {
  PENDING
  SOURCED
  REVIEW_REQUIRED
  NOT_FOUND
}

enum DocumentType {
  BOM
  DATASHEET
  COMMERCIAL_INVOICE
  PACKING_LIST
  AWB
  OTHER
}

enum DocumentProcessingStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum VendorRfqStatus {
  DRAFT
  SENT
  REPLIED
  CLOSED
}

enum VendorQuoteStatus {
  RECEIVED
  SELECTED
  REJECTED
}

enum LeadSource {
  GOOGLE_ORGANIC
  GOOGLE_ADS
  LINKEDIN
  WHATSAPP
  EMAIL
  DIRECT
  REFERRAL
  OTHER
  CONTACT
  REQUEST_QUOTE
  BOM
  CUSTOMER_PORTAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  ACKNOWLEDGED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ShipmentStatus {
  PROCESSING
  IN_TRANSIT
  CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum FollowUpType {
  DAY_1
  DAY_3
  DAY_7
  DAY_14
}

enum FollowUpStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id             String     @id @default(uuid()) @db.Uuid
  email          String     @unique
  passwordHash   String     @map("password_hash")
  role           UserRole   @default(CUSTOMER)
  status         UserStatus @default(PENDING_VERIFICATION)
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  phone          String?
  // Owner's User Master fields (Master value.xlsx) -- additive, admin-only
  // profile detail on top of the existing auth identity above. "Position"/
  // "Department" are Settings-driven LOV values (category strings, validated
  // against the Setting table at the API layer); organization is a real FK
  // to the existing Organization model.
  screenName     String?    @map("screen_name")
  organizationId String?    @map("organization_id") @db.Uuid
  position       String?
  department     String?
  mobile         String?
  address        String?
  skype          String?
  remarks        String?
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  customer                 Customer?
  organization             Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  refreshTokens            RefreshToken[]
  emailVerification        EmailVerification?
  accountSetupToken        AccountSetupToken?
  assignedLeads            Lead[]             @relation("LeadAssignee")
  createdQuotations        Quotation[]        @relation("QuotationCreator")
  salesForCompanies        Company[]          @relation("CompanySalesPerson")
  coordinatingForCompanies Company[]          @relation("CompanySalesCoordinator")
  sourcingForCompanies     Company[]          @relation("CompanySourcingOwner")

  @@index([organizationId])
  @@map("users")
}

model Company {
  id                        String   @id @default(uuid()) @db.Uuid
  name                      String
  gstin                     String?
  city                      String?
  address                   String?
  // Owner's Customer Master fields (Master value.xlsx) -- additive. Bill-to/
  // ship-to are kept distinct from the pre-existing generic `address` above
  // (never repurposed/renamed). String LOV fields (customerType,
  // relationshipType, paymentTerms, region, industrySegment) are
  // Settings-driven and validated against the Setting table at the API
  // layer, same pattern as User.position/department above. `contacts` is
  // the owner's flat "contact list" sub-table, stored as JSON rather than a
  // separate paginated child entity/table -- it is small, always loaded
  // with its parent, and never queried independently.
  shortName                 String?  @map("short_name")
  billToAddress             String?  @map("bill_to_address")
  shipToAddress             String?  @map("ship_to_address")
  // Additional ship-to locations beyond the single primary shipToAddress
  // above (owner's "Multiple Location" note) -- an array of plain address
  // strings, same lightweight JSON approach as `contacts` below.
  additionalShipToAddresses Json?    @map("additional_ship_to_addresses")
  state                     String?
  country                   String?
  // "Customer", "Vendor", or "Both" -- the owner's own explicit field,
  // distinct from which operational tables (Customer/Vendor) actually
  // reference this Company.
  relationshipType          String?  @map("relationship_type")
  customerType              String?  @map("customer_type")
  website                   String?
  fax                       String?
  // Owner's Customer Master "Phone" field (distinct from the portal
  // login User.phone) -- the company's own business phone number.
  phone                     String?
  primaryContact            String?  @map("primary_contact")
  contactEmail              String?  @map("contact_email")
  authorisedPerson          String?  @map("authorised_person")
  paymentTerms              String?  @map("payment_terms")
  creditLimit               Decimal? @map("credit_limit") @db.Decimal(18, 2)
  region                    String?
  salesPersonId             String?  @map("sales_person_id") @db.Uuid
  salesCoordinatorId        String?  @map("sales_coordinator_id") @db.Uuid
  sourcingOwnerId           String?  @map("sourcing_owner_id") @db.Uuid
  internalAccountNumber     String?  @map("internal_account_number")
  shippingAccount           String?  @map("shipping_account")
  bankDetails               String?  @map("bank_details")
  industrySegment           String?  @map("industry_segment")
  remarks                   String?
  contacts                  Json?
  // Deactivate-don't-delete for the Customer master record itself, same
  // pattern as Setting.isActive -- lets an admin retire a customer/vendor
  // company record without breaking its FK history (RFQs, quotations).
  isActive                  Boolean  @default(true) @map("is_active")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  customers        Customer[]
  salesPerson      User?      @relation("CompanySalesPerson", fields: [salesPersonId], references: [id], onDelete: SetNull)
  salesCoordinator User?      @relation("CompanySalesCoordinator", fields: [salesCoordinatorId], references: [id], onDelete: SetNull)
  sourcingOwner    User?      @relation("CompanySourcingOwner", fields: [sourcingOwnerId], references: [id], onDelete: SetNull)

  @@index([salesPersonId])
  @@index([salesCoordinatorId])
  @@index([sourcingOwnerId])
  @@map("companies")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  accountNumber String   @unique @map("account_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user       User        @relation(fields: [userId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])
  rfqs       Rfq[]
  documents  Document[]
  leads      Lead[]
  quotations Quotation[]
  salesOrders SalesOrder[]
  invoices    Invoice[]

  @@map("customers")
}

model Rfq {
  id               String          @id @default(uuid()) @db.Uuid
  rfqNumber        String          @unique @map("rfq_number")
  customerId       String          @map("customer_id") @db.Uuid
  status           RFQStatus       @default(DRAFT)
  sourcingStatus   SourcingStatus? @map("sourcing_status")
  priority         RFQPriority     @default(MEDIUM)
  deliveryLocation String?         @map("delivery_location")
  requiredDate     DateTime?       @map("required_date") @db.Date
  additionalNotes  String?         @map("additional_notes")
  internalNotes    String?         @map("internal_notes")
  submittedAt      DateTime?       @map("submitted_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  customer   Customer    @relation(fields: [customerId], references: [id])
  items      RfqItem[]
  documents  Document[]
  vendorRfqs VendorRfq[]
  lead       Lead?
  quotations Quotation[]
  salesOrders SalesOrder[]
  followUps  FollowUp[]

  @@map("rfqs")
}

model RfqItem {
  id             String        @id @default(uuid()) @db.Uuid
  rfqId          String        @map("rfq_id") @db.Uuid
  productId      String?       @map("product_id") @db.Uuid
  lineNumber     Int           @map("line_number")
  mpn            String
  manufacturer   String?
  description    String?
  quantity       Int
  targetPriceUsd Decimal?      @map("target_price_usd") @db.Decimal(18, 4)
  requiredDate   DateTime?     @map("required_date") @db.Date
  status         RFQItemStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  rfq            Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  vendorRfqItems VendorRfqItem[]
  vendorQuotes   VendorQuote[]
  quotationItems QuotationItem[]

  @@unique([rfqId, lineNumber])
  @@index([productId])
  @@map("rfq_items")
}

model Document {
  id               String                   @id @default(uuid()) @db.Uuid
  customerId       String?                  @map("customer_id") @db.Uuid
  rfqId            String?                  @map("rfq_id") @db.Uuid
  // Public website-enquiry (Lead) owner -- mutually exclusive with
  // customer/rfq. Keeps anonymous BOM-enquiry uploads isolated from
  // authenticated portal documents while reusing the same storage/parsing
  // pipeline and the same safe-metadata-only API shape.
  leadId           String?                  @map("lead_id") @db.Uuid
  documentType     DocumentType             @map("document_type")
  fileName         String                   @map("file_name")
  storageKey       String                   @map("storage_key")
  mimeType         String                   @map("mime_type")
  fileSizeBytes    Int                      @map("file_size_bytes")
  processingStatus DocumentProcessingStatus @default(UPLOADED) @map("processing_status")
  processingError  String?                  @map("processing_error")
  uploadedById     String?                  @map("uploaded_by_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id])
  rfq      Rfq?      @relation(fields: [rfqId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])

  @@index([leadId])
  @@map("documents")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  family    String
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

// One-time invitation for an administrator-provisioned customer. The raw token
// is never returned by the customer-management API and is only delivered by
// the configured email provider.
model AccountSetupToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_setup_tokens")
}

// Test-only email sink. Code can write here only when NODE_ENV=test and the
// `test` provider is selected. Production has no route that exposes this data.
model TestEmail {
  id        String   @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  html      String
  actionUrl String?  @map("action_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([to, createdAt])
  @@map("test_emails")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ─── P0-A: Vendor & Manufacturer ─────────────────────────────────────────────

model Manufacturer {
  id                String   @id @default(uuid()) @db.Uuid
  name              String
  slug              String   @unique
  logoUrl           String?  @map("logo_url")
  website           String?
  description       String?
  country           String?
  source            String   @default("MANUAL")
  sourceUrl         String?  @map("source_url")
  // Owner's Manufacturer Master fields (Master value.xlsx) -- additive.
  // logoUrl above already serves the owner's "Manufacturer Image" field.
  distributorLink   String?  @map("distributor_link")
  stockCheckLink    String?  @map("stock_check_link")
  acquiredMfr       String?  @map("acquired_mfr")
  remarks           String?
  suffixInformation String?  @map("suffix_information")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("manufacturers")
}

model Vendor {
  id                      String   @id @default(uuid()) @db.Uuid
  name                    String
  contactEmail            String   @map("contact_email")
  contactPhone            String?  @map("contact_phone")
  address                 String?
  notes                   String?
  // Owner's Vendor Master fields (Master value.xlsx) -- additive, same
  // Settings-driven/JSON-contact-list conventions as Company above.
  // contactName is the primary contact's name, paired with the pre-existing
  // contactEmail above -- distinct from the fuller `contacts` list below.
  contactName             String?  @map("contact_name")
  vendorCode              String?  @unique @map("vendor_code")
  billToAddress           String?  @map("bill_to_address")
  shipToAddress           String?  @map("ship_to_address")
  country                 String?
  telephone               String?
  fax                     String?
  mobile                  String?
  website                 String?
  otherOffices            String?  @map("other_offices")
  mov                     Decimal? @db.Decimal(18, 2)
  paymentCurrency         String?  @map("payment_currency")
  paymentTerms            String?  @map("payment_terms")
  shippingAccount         String?  @map("shipping_account")
  bankDetails             String?  @map("bank_details")
  creditLimit             Decimal? @map("credit_limit") @db.Decimal(18, 2)
  industrySegment         String?  @map("industry_segment")
  businessType            String?  @map("business_type")
  speciality              String?
  gstOrRegistrationNumber String?  @map("gst_or_registration_number")
  contacts                Json?
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  vendorRfqs VendorRfq[]
  purchaseOrders PurchaseOrder[]

  @@map("vendors")
}

model VendorRfq {
  id              String          @id @default(uuid()) @db.Uuid
  vendorRfqNumber String          @unique @map("vendor_rfq_number")
  rfqId           String          @map("rfq_id") @db.Uuid
  vendorId        String          @map("vendor_id") @db.Uuid
  status          VendorRfqStatus @default(DRAFT)
  emailSentAt     DateTime?       @map("email_sent_at")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  rfq        Rfq             @relation(fields: [rfqId], references: [id])
  vendor     Vendor          @relation(fields: [vendorId], references: [id])
  items      VendorRfqItem[]
  quotes     VendorQuote[]
  landedCost LandedCost?

  @@map("vendor_rfqs")
}

model VendorRfqItem {
  id          String  @id @default(uuid()) @db.Uuid
  vendorRfqId String  @map("vendor_rfq_id") @db.Uuid
  rfqItemId   String  @map("rfq_item_id") @db.Uuid
  quantity    Int
  notes       String?

  vendorRfq VendorRfq @relation(fields: [vendorRfqId], references: [id], onDelete: Cascade)
  rfqItem   RfqItem   @relation(fields: [rfqItemId], references: [id])

  @@map("vendor_rfq_items")
}

model VendorQuote {
  id           String            @id @default(uuid()) @db.Uuid
  vendorRfqId  String            @map("vendor_rfq_id") @db.Uuid
  rfqItemId    String            @map("rfq_item_id") @db.Uuid
  status       VendorQuoteStatus @default(RECEIVED)
  unitCost     Decimal           @map("unit_cost") @db.Decimal(18, 4)
  currency     String            @default("USD")
  leadTimeDays Int?              @map("lead_time_days")
  moq          Int?
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  vendorRfq   VendorRfq    @relation(fields: [vendorRfqId], references: [id], onDelete: Cascade)
  rfqItem     RfqItem      @relation(fields: [rfqItemId], references: [id])
  landedCosts LandedCost[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("vendor_quotes")
}

// ─── P0-B: Lead / CRM ────────────────────────────────────────────────────────

model Lead {
  id                    String              @id @default(uuid()) @db.Uuid
  referenceNumber       String?             @unique @map("reference_number")
  idempotencyKey        String?             @unique @map("idempotency_key")
  customerId            String?             @map("customer_id") @db.Uuid
  rfqId                 String?             @unique @map("rfq_id") @db.Uuid
  contactName           String              @map("contact_name")
  contactEmail          String              @map("contact_email")
  contactPhone          String?             @map("contact_phone")
  companyName           String              @map("company_name")
  subject               String?
  deliveryLocation      String?             @map("delivery_location")
  requiredDate          DateTime?           @map("required_date") @db.Date
  source                LeadSource          @default(DIRECT)
  status                LeadStatus          @default(NEW)
  priority              RFQPriority         @default(MEDIUM)
  notificationStatus    NotificationStatus? @map("notification_status")
  notificationSentAt    DateTime?           @map("notification_sent_at")
  notificationError     String?             @map("notification_error")
  notificationMessageId String?             @map("notification_message_id")
  assignedToId          String?             @map("assigned_to_id") @db.Uuid
  lastContactAt         DateTime?           @map("last_contact_at")
  nextFollowUpAt        DateTime?           @map("next_follow_up_at")
  notes                 String?
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  customer   Customer?  @relation(fields: [customerId], references: [id])
  rfq        Rfq?       @relation(fields: [rfqId], references: [id])
  assignedTo User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  items      LeadItem[]
  followUps  FollowUp[]
  documents  Document[]

  @@map("leads")
}

// ─── P0-B: Landed Cost ───────────────────────────────────────────────────────

model LandedCost {
  id            String   @id @default(uuid()) @db.Uuid
  vendorRfqId   String   @unique @map("vendor_rfq_id") @db.Uuid
  vendorQuoteId String?  @map("vendor_quote_id") @db.Uuid
  currency      String   @default("INR")
  exchangeRate  Decimal  @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  quantity      Int
  shipping      Decimal  @default(0) @db.Decimal(18, 4)
  insurance     Decimal  @default(0) @db.Decimal(18, 4)
  customsDuty   Decimal  @default(0) @map("customs_duty") @db.Decimal(18, 4)
  igst          Decimal  @default(0) @db.Decimal(18, 4)
  handling      Decimal  @default(0) @db.Decimal(18, 4)
  otherCosts    Decimal  @default(0) @map("other_costs") @db.Decimal(18, 4)
  marginPercent Decimal  @default(0) @map("margin_percent") @db.Decimal(8, 4)
  productCost   Decimal  @map("product_cost") @db.Decimal(18, 4)
  landedCost    Decimal  @map("landed_cost") @db.Decimal(18, 4)
  customerPrice Decimal  @map("customer_price") @db.Decimal(18, 4)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vendorRfq   VendorRfq    @relation(fields: [vendorRfqId], references: [id])
  vendorQuote VendorQuote? @relation(fields: [vendorQuoteId], references: [id])

  @@map("landed_costs")
}

// ─── P0-C: Quotation ─────────────────────────────────────────────────────────

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  quotationNumber String          @unique @map("quotation_number")
  rfqId           String          @map("rfq_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  landedCostId    String?         @map("landed_cost_id") @db.Uuid
  status          QuotationStatus @default(DRAFT)
  currency        String          @default("INR")
  subtotal        Decimal         @db.Decimal(18, 4)
  tax             Decimal         @default(0) @db.Decimal(18, 4)
  total           Decimal         @db.Decimal(18, 4)
  validUntil      DateTime        @map("valid_until") @db.Date
  notes           String?
  deliveryTerms   String?         @map("delivery_terms")
  paymentTerms    String?         @map("payment_terms")
  pdfStorageKey   String?         @map("pdf_storage_key")
  sentAt          DateTime?       @map("sent_at")
  viewedAt        DateTime?       @map("viewed_at")
  respondedAt     DateTime?       @map("responded_at")
  rejectionReason String?         @map("rejection_reason")
  createdById     String?         @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  rfq       Rfq             @relation(fields: [rfqId], references: [id])
  customer  Customer        @relation(fields: [customerId], references: [id])
  items     QuotationItem[]
  createdBy User?           @relation("QuotationCreator", fields: [createdById], references: [id])
  followUps FollowUp[]
  salesOrder SalesOrder?

  @@map("quotations")
}

model QuotationItem {
  id           String   @id @default(uuid()) @db.Uuid
  quotationId  String   @map("quotation_id") @db.Uuid
  rfqItemId    String?  @map("rfq_item_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  lineNumber   Int      @map("line_number")
  mpn          String
  manufacturer String?
  description  String?
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(18, 4)
  taxRate      Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount    Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal    Decimal  @map("line_total") @db.Decimal(18, 4)
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem   RfqItem?  @relation(fields: [rfqItemId], references: [id])
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  salesOrderItems SalesOrderItem[]

  @@index([productId])
  @@map("quotation_items")
}

model SalesOrder {
  id              String          @id @default(uuid()) @db.Uuid
  orderNumber     String          @unique @map("order_number")
  quotationId     String          @unique @map("quotation_id") @db.Uuid
  rfqId           String          @map("rfq_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  status          SalesOrderStatus @default(DRAFT)
  currency        String          @default("INR")
  subtotal        Decimal         @db.Decimal(18, 4)
  tax             Decimal         @default(0) @db.Decimal(18, 4)
  total           Decimal         @db.Decimal(18, 4)
  deliveryAddress String?         @map("delivery_address")
  notes           String?
  confirmedAt     DateTime?       @map("confirmed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  quotation      Quotation       @relation(fields: [quotationId], references: [id])
  rfq            Rfq             @relation(fields: [rfqId], references: [id])
  customer       Customer        @relation(fields: [customerId], references: [id])
  items          SalesOrderItem[]
  purchaseOrders PurchaseOrder[]
  shipments      Shipment[]
  invoices       Invoice[]

  @@index([customerId, createdAt])
  @@index([rfqId])
  @@index([status, createdAt])
  @@map("sales_orders")
}

model SalesOrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  salesOrderId   String   @map("sales_order_id") @db.Uuid
  quotationItemId String? @map("quotation_item_id") @db.Uuid
  lineNumber     Int      @map("line_number")
  mpn            String
  manufacturer   String?
  description    String?
  quantity       Int
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 4)
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal      Decimal  @map("line_total") @db.Decimal(18, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  salesOrder    SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  quotationItem QuotationItem? @relation(fields: [quotationItemId], references: [id], onDelete: SetNull)
  purchaseItems PurchaseOrderItem[]

  @@unique([salesOrderId, lineNumber])
  @@index([quotationItemId])
  @@map("sales_order_items")
}

model PurchaseOrder {
  id                  String             @id @default(uuid()) @db.Uuid
  orderNumber         String             @unique @map("order_number")
  salesOrderId        String             @map("sales_order_id") @db.Uuid
  vendorId            String             @map("vendor_id") @db.Uuid
  status              PurchaseOrderStatus @default(DRAFT)
  currency            String             @default("USD")
  subtotal            Decimal            @db.Decimal(18, 4)
  total               Decimal            @db.Decimal(18, 4)
  expectedDate        DateTime?          @map("expected_date") @db.Date
  notes               String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  salesOrder SalesOrder        @relation(fields: [salesOrderId], references: [id])
  vendor     Vendor            @relation(fields: [vendorId], references: [id])
  items      PurchaseOrderItem[]
  shipments  Shipment[]

  @@index([salesOrderId])
  @@index([vendorId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id             String   @id @default(uuid()) @db.Uuid
  purchaseOrderId String  @map("purchase_order_id") @db.Uuid
  salesOrderItemId String? @map("sales_order_item_id") @db.Uuid
  vendorQuoteId  String?  @map("vendor_quote_id") @db.Uuid
  lineNumber     Int      @map("line_number")
  mpn            String
  quantity       Int
  unitCost       Decimal  @map("unit_cost") @db.Decimal(18, 4)
  lineTotal      Decimal  @map("line_total") @db.Decimal(18, 4)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id], onDelete: SetNull)
  vendorQuote   VendorQuote? @relation(fields: [vendorQuoteId], references: [id], onDelete: SetNull)

  @@unique([purchaseOrderId, lineNumber])
  @@index([salesOrderItemId])
  @@index([vendorQuoteId])
  @@map("purchase_order_items")
}

model Shipment {
  id              String         @id @default(uuid()) @db.Uuid
  shipmentNumber  String         @unique @map("shipment_number")
  salesOrderId    String         @map("sales_order_id") @db.Uuid
  purchaseOrderId String?        @map("purchase_order_id") @db.Uuid
  status          ShipmentStatus  @default(PROCESSING)
  trackingNumber  String?        @map("tracking_number")
  carrier         String?
  origin          String?
  destination     String?
  eta             DateTime?       @db.Date
  deliveredAt     DateTime?       @map("delivered_at")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([salesOrderId, status])
  @@index([purchaseOrderId])
  @@index([trackingNumber])
  @@map("shipments")
}

model Invoice {
  id           String        @id @default(uuid()) @db.Uuid
  invoiceNumber String       @unique @map("invoice_number")
  salesOrderId String        @map("sales_order_id") @db.Uuid
  customerId   String        @map("customer_id") @db.Uuid
  status       InvoiceStatus @default(DRAFT)
  currency     String        @default("INR")
  subtotal     Decimal       @db.Decimal(18, 4)
  tax          Decimal       @default(0) @db.Decimal(18, 4)
  total        Decimal       @db.Decimal(18, 4)
  dueDate      DateTime?     @map("due_date") @db.Date
  issuedAt     DateTime?     @map("issued_at")
  paidAt       DateTime?     @map("paid_at")
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  salesOrder SalesOrder  @relation(fields: [salesOrderId], references: [id])
  customer  Customer    @relation(fields: [customerId], references: [id])
  items     InvoiceItem[]

  @@index([customerId, createdAt])
  @@index([salesOrderId])
  @@index([status, dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @map("invoice_id") @db.Uuid
  lineNumber  Int      @map("line_number")
  mpn         String
  description String?
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 4)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal   Decimal  @map("line_total") @db.Decimal(18, 4)
  createdAt   DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, lineNumber])
  @@map("invoice_items")
}

// ─── P0-D: Follow-up Automation ──────────────────────────────────────────────

model FollowUp {
  id            String         @id @default(uuid()) @db.Uuid
  leadId        String?        @map("lead_id") @db.Uuid
  rfqId         String?        @map("rfq_id") @db.Uuid
  quotationId   String?        @map("quotation_id") @db.Uuid
  type          FollowUpType
  status        FollowUpStatus @default(SCHEDULED)
  attempt       Int            @default(1)
  scheduledAt   DateTime       @map("scheduled_at")
  sentAt        DateTime?      @map("sent_at")
  cancelledAt   DateTime?      @map("cancelled_at")
  failureReason String?        @map("failure_reason")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  lead      Lead?      @relation(fields: [leadId], references: [id])
  rfq       Rfq?       @relation(fields: [rfqId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  @@unique([rfqId, type])
  @@map("follow_ups")
}

// ─── Owner Master Data: Organization + Settings/LOV ──────────────────────────
// Scope: this pass implements Organization + a generic Settings/LOV store only
// (owner-selected scope). See docs/OWNER-MASTER-DATA-COMPLIANCE.md for the
// full Excel gap analysis — Customer/Vendor/Manufacturer/Product/Category/User
// field extensions are tracked there but intentionally not built this pass.

model Organization {
  id                    String   @id @default(uuid()) @db.Uuid
  companyName           String   @map("company_name")
  shortName             String   @map("short_name")
  address               String?
  country               String?
  phone                 String?
  email                 String?
  website               String?
  contactPerson         String?  @map("contact_person")
  ffAccount             String?  @map("ff_account")
  currency              String   @default("INR")
  companyRegistrationNo String?  @map("company_registration_no")
  invoicePrefix         String?  @map("invoice_prefix")
  proformaInvoicePrefix String?  @map("proforma_invoice_prefix")
  packingSlipPrefix     String?  @map("packing_slip_prefix")
  cocPrefix             String?  @map("coc_prefix")
  orderAckPrefix        String?  @map("order_ack_prefix")
  quotationPrefix       String?  @map("quotation_prefix")
  salesOrderPrefix      String?  @map("sales_order_prefix")
  purchaseOrderPrefix   String?  @map("purchase_order_prefix")
  itemNoPrefix          String?  @map("item_no_prefix")
  vendorCodePrefix      String?  @map("vendor_code_prefix")
  customerCodePrefix    String?  @map("customer_code_prefix")
  contactCodePrefix     String?  @map("contact_code_prefix")
  location              String?
  rmaPrefix             String?  @map("rma_prefix")
  bankName              String?  @map("bank_name")
  bankAccount           String?  @map("bank_account")
  bankAddress           String?  @map("bank_address")
  swiftIfscMicr         String?  @map("swift_ifsc_micr")
  routingCode           String?  @map("routing_code")
  signatureUrl          String?  @map("signature_url")
  logoUrl               String?  @map("logo_url")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("organizations")
}

// Generic LOV store backing all Settings categories (Customer Type, Payment
// Terms, Delivery Terms, Currency, Region, Packaging, UOM, ...). One table
// instead of one enum/table per category — matches the owner's Excel, which
// lists ~25 categories side by side in a single "Settings" sheet.
model Setting {
  id         String   @id @default(uuid()) @db.Uuid
  category   String
  value      String
  sortOrder  Int      @default(0) @map("sort_order")
  isEditable Boolean  @default(true) @map("is_editable")
  // Deactivating a value hides it from future dropdown options without
  // deleting it -- any existing record that already stored this value (a
  // plain string, no FK) keeps displaying correctly, since reads never
  // re-validate against Settings, only writes do (see
  // lib/settings-validation.ts).
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([category, value])
  @@index([category])
  @@map("settings")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  parentId    String?  @map("parent_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String    @id @default(uuid()) @db.Uuid
  // MPN text is no longer globally unique on its own: two different real
  // manufacturers can legitimately share an MPN string. Canonical matching
  // during import is manufacturer-aware (normalizedMpn + manufacturerId) —
  // see upsert.ts's findExistingProduct(). mpn/normalizedMpn stay indexed
  // (not unique) so search and the public /products/:mpn lookup stay fast;
  // when a source provides no manufacturer at all, import falls back to
  // plain-normalizedMpn matching (see upsert.ts comment) since there is no
  // stronger signal available.
  mpn             String
  normalizedMpn   String    @map("normalized_mpn")
  name            String?
  description     String?
  manufacturerId  String?   @map("manufacturer_id") @db.Uuid
  categoryId      String?   @map("category_id") @db.Uuid
  specifications  Json?
  packageType     String?   @map("package_type")
  mountingType    String?   @map("mounting_type")
  lifecycleStatus String?   @map("lifecycle_status")
  datasheetUrl    String?   @map("datasheet_url")
  images          String[]  @default([])
  isActive        Boolean   @default(true) @map("is_active")
  source          String    @default("MANUAL")
  sourceUrl       String?   @map("source_url")
  sourceProductId String?   @map("source_product_id")
  lastImportedAt  DateTime? @map("last_imported_at")
  dataHash        String?   @map("data_hash")
  importStatus    String    @default("MANUAL") @map("import_status")
  // Owner's Product Master fields (Master value.xlsx) -- additive,
  // admin/internal-only (never selected into the public toPublicProduct()
  // DTO). "Part Status" (Active/Deactive) reuses the existing `isActive`
  // above rather than adding a duplicate field. `packaging` (owner's
  // BULK/TUBE/REEL/BOX shipping unit) is a different concept from the
  // pre-existing `packageType` (physical package like "8-DIP") and is kept
  // as a separate field rather than overloading/renaming that column.
  // Quotation/sales/purchase history is intentionally NOT stored here --
  // it is derived from the existing RfqItem/QuotationItem relations below.
  productCode     String?   @map("product_code")
  spq             Int?
  packaging       String?
  uom             String?
  hsCode          String?   @map("hs_code")
  hsDescription   String?   @map("hs_description")
  productGroup    String?   @map("product_group")
  eccn            String?
  availableStock  Int?      @map("available_stock")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  manufacturer   Manufacturer?   @relation(fields: [manufacturerId], references: [id])
  category       Category?       @relation(fields: [categoryId], references: [id])
  rfqItems       RfqItem[]
  quotationItems QuotationItem[]
  leadItems      LeadItem[]
  sources        ProductSource[]

  @@unique([normalizedMpn, manufacturerId], name: "product_normalizedMpn_manufacturer_unique")
  @@index([normalizedMpn])
  @@index([mpn])
  @@index([name])
  @@index([manufacturerId])
  @@index([categoryId])
  @@index([isActive, mpn])
  @@index([isActive, categoryId])
  @@index([isActive, manufacturerId])
  @@map("products")
}

// Provider-specific catalog data is intentionally separate from the public
// canonical Product. A second legitimate source must not overwrite the first
// source's provenance or create a duplicate product page.
model ProductSource {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  source          String
  sourceProductId String?  @map("source_product_id")
  sourceUrl       String?  @map("source_url")
  datasheetUrl    String?  @map("datasheet_url")
  images          String[] @default([])
  specifications  Json?
  lifecycleStatus String?  @map("lifecycle_status")
  // Internal-sourcing-only commercial data (seller name, price, stock,
  // MOQ, lead time, offer URL) for sources that provide it. Deliberately
  // never read by the public product API
  // (products.routes.ts only selects Product with manufacturer/category,
  // never `sources`) or any customer-facing response.
  internalOffers  Json?    @map("internal_offers")
  dataHash        String?  @map("data_hash")
  lastImportedAt  DateTime @default(now()) @map("last_imported_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, source])
  @@index([source, sourceProductId])
  @@map("product_sources")
}

model CatalogImportRun {
  id             String    @id @default(uuid()) @db.Uuid
  source         String
  status         String    @default("RUNNING")
  cursor         String?
  itemsProcessed Int       @default(0) @map("items_processed")
  itemsCreated   Int       @default(0) @map("items_created")
  itemsUpdated   Int       @default(0) @map("items_updated")
  itemsFailed    Int       @default(0) @map("items_failed")
  errorLog       Json?     @map("error_log")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")

  @@map("catalog_import_runs")
}

model LeadItem {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  productId    String?  @map("product_id") @db.Uuid
  lineNumber   Int      @map("line_number")
  mpn          String
  manufacturer String?
  description  String?
  quantity     Int
  createdAt    DateTime @default(now()) @map("created_at")

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([leadId, lineNumber])
  @@index([productId])
  @@map("lead_items")
}
