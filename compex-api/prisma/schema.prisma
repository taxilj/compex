generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum RFQStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SOURCING
  CANCELLED
}

enum RFQPriority {
  LOW
  MEDIUM
  HIGH
}

enum RFQItemStatus {
  PENDING
  SOURCED
  REVIEW_REQUIRED
  NOT_FOUND
}

enum DocumentType {
  BOM
  DATASHEET
  COMMERCIAL_INVOICE
  PACKING_LIST
  AWB
  OTHER
}

enum DocumentProcessingStatus {
  UPLOADED
  PROCESSING
  COMPLETED
  FAILED
}

enum VendorRfqStatus {
  DRAFT
  SENT
  REPLIED
  CLOSED
}

enum VendorQuoteStatus {
  RECEIVED
  SELECTED
  REJECTED
}

enum LeadSource {
  GOOGLE_ORGANIC
  GOOGLE_ADS
  LINKEDIN
  WHATSAPP
  EMAIL
  DIRECT
  REFERRAL
  OTHER
  CONTACT
  REQUEST_QUOTE
  BOM
  CUSTOMER_PORTAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum FollowUpType {
  DAY_1
  DAY_3
  DAY_7
  DAY_14
}

enum FollowUpStatus {
  SCHEDULED
  SENT
  CANCELLED
  FAILED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  role         UserRole   @default(CUSTOMER)
  status       UserStatus @default(PENDING_VERIFICATION)
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  phone        String?
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  customer           Customer?
  refreshTokens      RefreshToken[]
  emailVerification  EmailVerification?
  accountSetupToken  AccountSetupToken?
  assignedLeads      Lead[]             @relation("LeadAssignee")
  createdQuotations  Quotation[]        @relation("QuotationCreator")
  @@map("users")
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  gstin     String?
  city      String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customers Customer[]

  @@map("companies")
}

model Customer {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @unique @map("user_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  accountNumber String   @unique @map("account_number")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user        User        @relation(fields: [userId], references: [id])
  company     Company     @relation(fields: [companyId], references: [id])
  rfqs        Rfq[]
  documents   Document[]
  leads       Lead[]
  quotations  Quotation[]

  @@map("customers")
}

model Rfq {
  id               String      @id @default(uuid()) @db.Uuid
  rfqNumber        String      @unique @map("rfq_number")
  customerId       String      @map("customer_id") @db.Uuid
  status           RFQStatus   @default(DRAFT)
  priority         RFQPriority @default(MEDIUM)
  deliveryLocation String?     @map("delivery_location")
  requiredDate     DateTime?   @map("required_date") @db.Date
  additionalNotes  String?     @map("additional_notes")
  internalNotes    String?     @map("internal_notes")
  submittedAt      DateTime?   @map("submitted_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  customer    Customer    @relation(fields: [customerId], references: [id])
  items       RfqItem[]
  documents   Document[]
  vendorRfqs  VendorRfq[]
  lead        Lead?
  quotations  Quotation[]
  followUps   FollowUp[]

  @@map("rfqs")
}

model RfqItem {
  id             String        @id @default(uuid()) @db.Uuid
  rfqId          String        @map("rfq_id") @db.Uuid
  lineNumber     Int           @map("line_number")
  mpn            String
  manufacturer   String?
  description    String?
  quantity       Int
  targetPriceUsd Decimal?      @map("target_price_usd") @db.Decimal(18, 4)
  requiredDate   DateTime?     @map("required_date") @db.Date
  status         RFQItemStatus @default(PENDING)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  rfq              Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendorRfqItems   VendorRfqItem[]
  vendorQuotes     VendorQuote[]
  quotationItems   QuotationItem[]

  @@unique([rfqId, lineNumber])
  @@map("rfq_items")
}

model Document {
  id               String                   @id @default(uuid()) @db.Uuid
  customerId       String?                  @map("customer_id") @db.Uuid
  rfqId            String?                  @map("rfq_id") @db.Uuid
  documentType     DocumentType             @map("document_type")
  fileName         String                   @map("file_name")
  storageKey       String                   @map("storage_key")
  mimeType         String                   @map("mime_type")
  fileSizeBytes    Int                      @map("file_size_bytes")
  processingStatus DocumentProcessingStatus @default(UPLOADED) @map("processing_status")
  processingError  String?                  @map("processing_error")
  uploadedById     String?                  @map("uploaded_by_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  customer Customer? @relation(fields: [customerId], references: [id])
  rfq      Rfq?      @relation(fields: [rfqId], references: [id])

  @@map("documents")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  family    String
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verifications")
}

// One-time invitation for an administrator-provisioned customer. The raw token
// is never returned by the customer-management API and is only delivered by
// the configured email provider.
model AccountSetupToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @unique @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  usedAt     DateTime? @map("used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account_setup_tokens")
}

// Test-only email sink. Code can write here only when NODE_ENV=test and the
// `test` provider is selected. Production has no route that exposes this data.
model TestEmail {
  id        String   @id @default(uuid()) @db.Uuid
  to        String
  subject   String
  html      String
  actionUrl String?  @map("action_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([to, createdAt])
  @@map("test_emails")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ─── P0-A: Vendor & Manufacturer ─────────────────────────────────────────────

model Manufacturer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  website   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("manufacturers")
}

model Vendor {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  contactEmail String   @map("contact_email")
  contactPhone String?  @map("contact_phone")
  address      String?
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  vendorRfqs VendorRfq[]

  @@map("vendors")
}

model VendorRfq {
  id             String          @id @default(uuid()) @db.Uuid
  vendorRfqNumber String         @unique @map("vendor_rfq_number")
  rfqId          String          @map("rfq_id") @db.Uuid
  vendorId       String          @map("vendor_id") @db.Uuid
  status         VendorRfqStatus @default(DRAFT)
  emailSentAt    DateTime?       @map("email_sent_at")
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  rfq        Rfq             @relation(fields: [rfqId], references: [id])
  vendor     Vendor          @relation(fields: [vendorId], references: [id])
  items      VendorRfqItem[]
  quotes     VendorQuote[]
  landedCost LandedCost?

  @@map("vendor_rfqs")
}

model VendorRfqItem {
  id          String @id @default(uuid()) @db.Uuid
  vendorRfqId String @map("vendor_rfq_id") @db.Uuid
  rfqItemId   String @map("rfq_item_id") @db.Uuid
  quantity    Int
  notes       String?

  vendorRfq VendorRfq @relation(fields: [vendorRfqId], references: [id], onDelete: Cascade)
  rfqItem   RfqItem   @relation(fields: [rfqItemId], references: [id])

  @@map("vendor_rfq_items")
}

model VendorQuote {
  id           String            @id @default(uuid()) @db.Uuid
  vendorRfqId  String            @map("vendor_rfq_id") @db.Uuid
  rfqItemId    String            @map("rfq_item_id") @db.Uuid
  status       VendorQuoteStatus @default(RECEIVED)
  unitCost     Decimal           @map("unit_cost") @db.Decimal(18, 4)
  currency     String            @default("USD")
  leadTimeDays Int?              @map("lead_time_days")
  moq          Int?
  notes        String?
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  vendorRfq   VendorRfq    @relation(fields: [vendorRfqId], references: [id], onDelete: Cascade)
  rfqItem     RfqItem      @relation(fields: [rfqItemId], references: [id])
  landedCosts LandedCost[]

  @@map("vendor_quotes")
}

// ─── P0-B: Lead / CRM ────────────────────────────────────────────────────────

model Lead {
  id             String      @id @default(uuid()) @db.Uuid
  referenceNumber String?    @unique @map("reference_number")
  idempotencyKey String?     @unique @map("idempotency_key")
  customerId     String?     @map("customer_id") @db.Uuid
  rfqId          String?     @unique @map("rfq_id") @db.Uuid
  contactName    String      @map("contact_name")
  contactEmail   String      @map("contact_email")
  contactPhone   String?     @map("contact_phone")
  companyName    String      @map("company_name")
  subject        String?
  deliveryLocation String?   @map("delivery_location")
  requiredDate   DateTime?   @map("required_date") @db.Date
  source         LeadSource  @default(DIRECT)
  status         LeadStatus  @default(NEW)
  priority       RFQPriority @default(MEDIUM)
  notificationStatus NotificationStatus? @map("notification_status")
  notificationSentAt DateTime? @map("notification_sent_at")
  notificationError String?  @map("notification_error")
  notificationMessageId String? @map("notification_message_id")
  assignedToId   String?     @map("assigned_to_id") @db.Uuid
  lastContactAt  DateTime?   @map("last_contact_at")
  nextFollowUpAt DateTime?   @map("next_follow_up_at")
  notes          String?
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  customer   Customer?  @relation(fields: [customerId], references: [id])
  rfq        Rfq?       @relation(fields: [rfqId], references: [id])
  assignedTo User?      @relation("LeadAssignee", fields: [assignedToId], references: [id])
  items      LeadItem[]
  followUps  FollowUp[]

  @@map("leads")
}

// ─── P0-B: Landed Cost ───────────────────────────────────────────────────────

model LandedCost {
  id            String   @id @default(uuid()) @db.Uuid
  vendorRfqId   String   @unique @map("vendor_rfq_id") @db.Uuid
  vendorQuoteId String?  @map("vendor_quote_id") @db.Uuid
  currency      String   @default("INR")
  exchangeRate  Decimal  @default(1) @map("exchange_rate") @db.Decimal(18, 6)
  quantity      Int
  shipping      Decimal  @default(0) @db.Decimal(18, 4)
  insurance     Decimal  @default(0) @db.Decimal(18, 4)
  customsDuty   Decimal  @default(0) @map("customs_duty") @db.Decimal(18, 4)
  igst          Decimal  @default(0) @db.Decimal(18, 4)
  handling      Decimal  @default(0) @db.Decimal(18, 4)
  otherCosts    Decimal  @default(0) @map("other_costs") @db.Decimal(18, 4)
  marginPercent Decimal  @default(0) @map("margin_percent") @db.Decimal(8, 4)
  productCost   Decimal  @map("product_cost") @db.Decimal(18, 4)
  landedCost    Decimal  @map("landed_cost") @db.Decimal(18, 4)
  customerPrice Decimal  @map("customer_price") @db.Decimal(18, 4)
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  vendorRfq   VendorRfq    @relation(fields: [vendorRfqId], references: [id])
  vendorQuote VendorQuote? @relation(fields: [vendorQuoteId], references: [id])

  @@map("landed_costs")
}

// ─── P0-C: Quotation ─────────────────────────────────────────────────────────

model Quotation {
  id              String          @id @default(uuid()) @db.Uuid
  quotationNumber String          @unique @map("quotation_number")
  rfqId           String          @map("rfq_id") @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  landedCostId    String?         @map("landed_cost_id") @db.Uuid
  status          QuotationStatus @default(DRAFT)
  currency        String          @default("INR")
  subtotal        Decimal         @db.Decimal(18, 4)
  tax             Decimal         @default(0) @db.Decimal(18, 4)
  total           Decimal         @db.Decimal(18, 4)
  validUntil      DateTime        @map("valid_until") @db.Date
  notes           String?
  deliveryTerms   String?         @map("delivery_terms")
  paymentTerms    String?         @map("payment_terms")
  pdfStorageKey   String?         @map("pdf_storage_key")
  sentAt          DateTime?       @map("sent_at")
  viewedAt        DateTime?       @map("viewed_at")
  respondedAt     DateTime?       @map("responded_at")
  rejectionReason String?         @map("rejection_reason")
  createdById     String?         @map("created_by_id") @db.Uuid
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  rfq       Rfq             @relation(fields: [rfqId], references: [id])
  customer  Customer        @relation(fields: [customerId], references: [id])
  items     QuotationItem[]
  createdBy User?           @relation("QuotationCreator", fields: [createdById], references: [id])
  followUps FollowUp[]

  @@map("quotations")
}

model QuotationItem {
  id          String   @id @default(uuid()) @db.Uuid
  quotationId String   @map("quotation_id") @db.Uuid
  rfqItemId   String?  @map("rfq_item_id") @db.Uuid
  lineNumber  Int      @map("line_number")
  mpn         String
  manufacturer String?
  description String?
  quantity    Int
  unitPrice   Decimal  @map("unit_price") @db.Decimal(18, 4)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxAmount   Decimal  @default(0) @map("tax_amount") @db.Decimal(18, 4)
  lineTotal   Decimal  @map("line_total") @db.Decimal(18, 4)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  rfqItem   RfqItem?  @relation(fields: [rfqItemId], references: [id])

  @@map("quotation_items")
}

// ─── P0-D: Follow-up Automation ──────────────────────────────────────────────

model FollowUp {
  id            String         @id @default(uuid()) @db.Uuid
  leadId        String?        @map("lead_id") @db.Uuid
  rfqId         String?        @map("rfq_id") @db.Uuid
  quotationId   String?        @map("quotation_id") @db.Uuid
  type          FollowUpType
  status        FollowUpStatus @default(SCHEDULED)
  attempt       Int            @default(1)
  scheduledAt   DateTime       @map("scheduled_at")
  sentAt        DateTime?      @map("sent_at")
  cancelledAt   DateTime?      @map("cancelled_at")
  failureReason String?        @map("failure_reason")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  lead      Lead?      @relation(fields: [leadId], references: [id])
  rfq       Rfq?       @relation(fields: [rfqId], references: [id])
  quotation Quotation? @relation(fields: [quotationId], references: [id])

  @@unique([rfqId, type])
  @@map("follow_ups")
}

// ─── Owner Master Data: Organization + Settings/LOV ──────────────────────────
// Scope: this pass implements Organization + a generic Settings/LOV store only
// (owner-selected scope). See docs/OWNER-MASTER-DATA-COMPLIANCE.md for the
// full Excel gap analysis — Customer/Vendor/Manufacturer/Product/Category/User
// field extensions are tracked there but intentionally not built this pass.

model Organization {
  id                    String   @id @default(uuid()) @db.Uuid
  companyName           String   @map("company_name")
  shortName             String   @map("short_name")
  address               String?
  country               String?
  phone                 String?
  email                 String?
  website               String?
  contactPerson         String?  @map("contact_person")
  ffAccount             String?  @map("ff_account")
  currency              String   @default("INR")
  companyRegistrationNo String?  @map("company_registration_no")
  invoicePrefix         String?  @map("invoice_prefix")
  proformaInvoicePrefix String?  @map("proforma_invoice_prefix")
  packingSlipPrefix     String?  @map("packing_slip_prefix")
  cocPrefix             String?  @map("coc_prefix")
  orderAckPrefix        String?  @map("order_ack_prefix")
  quotationPrefix       String?  @map("quotation_prefix")
  salesOrderPrefix      String?  @map("sales_order_prefix")
  purchaseOrderPrefix   String?  @map("purchase_order_prefix")
  itemNoPrefix          String?  @map("item_no_prefix")
  vendorCodePrefix      String?  @map("vendor_code_prefix")
  customerCodePrefix    String?  @map("customer_code_prefix")
  contactCodePrefix     String?  @map("contact_code_prefix")
  location              String?
  rmaPrefix             String?  @map("rma_prefix")
  bankName              String?  @map("bank_name")
  bankAccount           String?  @map("bank_account")
  bankAddress           String?  @map("bank_address")
  swiftIfscMicr         String?  @map("swift_ifsc_micr")
  routingCode           String?  @map("routing_code")
  signatureUrl          String?  @map("signature_url")
  logoUrl               String?  @map("logo_url")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

// Generic LOV store backing all Settings categories (Customer Type, Payment
// Terms, Delivery Terms, Currency, Region, Packaging, UOM, ...). One table
// instead of one enum/table per category — matches the owner's Excel, which
// lists ~25 categories side by side in a single "Settings" sheet.
model Setting {
  id         String   @id @default(uuid()) @db.Uuid
  category   String
  value      String
  sortOrder  Int      @default(0) @map("sort_order")
  isEditable Boolean  @default(true) @map("is_editable")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([category, value])
  @@index([category])
  @@map("settings")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products Product[]

  @@map("categories")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  mpn            String        @unique
  description    String?
  manufacturerId String?       @map("manufacturer_id") @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  manufacturer Manufacturer? @relation(fields: [manufacturerId], references: [id])
  category     Category?     @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model LeadItem {
  id           String   @id @default(uuid()) @db.Uuid
  leadId       String   @map("lead_id") @db.Uuid
  lineNumber   Int      @map("line_number")
  mpn          String
  manufacturer String?
  description  String?
  quantity     Int
  createdAt    DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([leadId, lineNumber])
  @@map("lead_items")
}
