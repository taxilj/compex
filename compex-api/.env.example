# PostgreSQL
DATABASE_URL="postgresql://<user>:<password>@localhost:5432/compex_dev"

# JWT - use strong random secrets in production (min 256 bits)
JWT_SECRET="change-me-use-a-256-bit-random-secret"
JWT_REFRESH_SECRET="change-me-use-a-different-256-bit-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis (required for BullMQ BOM processing)
REDIS_URL="redis://localhost:6379"

# Storage: "local" for development/QA; production requires "s3".
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# S3 / Cloudflare R2 (required when STORAGE_PROVIDER=s3)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"

# Server
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"

# CORS - comma-separated origins
CORS_ORIGIN="http://localhost:3000"

# Email. `log` deliberately does not deliver mail. Production requires SMTP.
# Use `test` only with NODE_ENV=test and a dedicated *_test database.
EMAIL_PROVIDER="log"
EMAIL_FROM="noreply@compexsolution.com"
ENQUIRY_NOTIFICATION_TO="sales@compexsolution.com"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Mouser Search API — free key from https://www.mouser.com/api-hub/ (My Mouser
# account -> APIs -> create a Search API key). Optional: catalog import works
# without it (CSV/XLSX fetcher); only the Mouser lookup route needs it.
MOUSER_API_KEY=""

# element14 Product Search API. Register at developer.element14.com and use a
# country-specific store id only when the account is authorised for it.
ELEMENT14_API_KEY=""
ELEMENT14_STORE_ID="in.element14.com"

# DigiKey Product Information V4. Both values are needed for OAuth; do not put
# either value in the frontend or commit a real credential.
DIGIKEY_CLIENT_ID=""
DIGIKEY_CLIENT_SECRET=""

# Nexar Supply API (https://portal.nexar.com) -- OAuth2 client credentials
# against https://identity.nexar.com/connect/token, GraphQL endpoint
# https://api.nexar.com/graphql. Both values are needed for the /admin/
# catalog-import/nexar/:mpn lookup; server-only, never sent to the frontend,
# never committed. See README.md "Nexar setup" for the full walkthrough.
NEXAR_CLIENT_ID=""
NEXAR_CLIENT_SECRET=""
NEXAR_SCOPE="supply.domain"

# How long (seconds) a repeated exact-MPN Nexar lookup is served from the
# shared Redis cache instead of re-hitting the upstream API. 0 disables
# caching. Uses the same REDIS_URL as the BullMQ queues above -- no
# additional infrastructure required.
NEXAR_CACHE_TTL_SECONDS="3600"
