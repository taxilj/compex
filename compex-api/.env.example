# PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/compex_dev"

# JWT - use strong random secrets in production (min 256 bits)
JWT_SECRET="change-me-use-a-256-bit-random-secret"
JWT_REFRESH_SECRET="change-me-use-a-different-256-bit-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# Redis (required for BullMQ BOM processing)
REDIS_URL="redis://localhost:6379"

# Storage: "local" for development, "s3" for production
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./uploads"

# S3 / Cloudflare R2 (required when STORAGE_PROVIDER=s3)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"

# Server
PORT=4000
HOST="0.0.0.0"
NODE_ENV="development"

# CORS - comma-separated origins
CORS_ORIGIN="http://localhost:3000"

# Email (optional in dev - logs to console when not set)
EMAIL_PROVIDER="log"
EMAIL_FROM="noreply@compexsolution.com"
ENQUIRY_NOTIFICATION_TO="sales@compexsolution.com"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
